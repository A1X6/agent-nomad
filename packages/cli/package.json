{
  "name": "@agentnomad/cli",
  "version": "0.0.0",
  "private": true,
  "description": "agentnomad command-line interface: commands, prompts, file system, API client, agent adapters",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentnomad": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "agentnomad-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentnomad/contracts": "workspace:*",
    "@agentnomad/core": "workspace:*",
    "@clack/prompts": "1.8.1",
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0",
    "zod": "4.6.5"
  }
}
