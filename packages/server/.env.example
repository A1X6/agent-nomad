# Copy to .env (git-ignored) and fill in. Never commit the real values.

# Neon: use the DIRECT connection string (host without "-pooler") for migrations.
# The deployed API uses the pooled one instead.
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# At least 32 random bytes, base64. Generate once with:  openssl rand -base64 32
# Keys the auth-key hashes and fake prelogin salts. NEVER change or lose it: every existing
# user would be unable to log in.
SERVER_SECRET=
